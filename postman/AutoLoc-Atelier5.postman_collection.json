      "name": "Agences",
      "item": [
        {
          "name": "01 - Creer une agence - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Tunis Centre\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Avenue Habib Bourguiba\",\n  \"telephone\": \"71000000\"\n}"
            },
            "url": "{{baseUrl}}/agences"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"agenceId\", pm.response.json().idAgence);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Lister les agences - 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/agences"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reponse tableau JSON\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Consulter une agence - 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/agences/{{agenceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Bon identifiant\", () => pm.expect(String(pm.response.json().idAgence)).to.eql(pm.collectionVariables.get(\"agenceId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Modifier une agence - 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Tunis Lac\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Les Berges du Lac\",\n  \"telephone\": \"71111111\"\n}"
            },
            "url": "{{baseUrl}}/agences/{{agenceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Nom modifie\", () => pm.expect(pm.response.json().nom).to.eql(\"Agence Tunis Lac\"));"
                ]
              }
            }
          ]
        },
